<?xml version="1.0" encoding="utf-8"?>

<resources>

    <!-- Settings and the license pages: Material 3, light or dark with the system, with the
         wallpaper's colours from Android 12 on (DynamicColors in their onCreate) -->
    <style name="Theme.Appine" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/appine_primary</item>
        <item name="colorOnPrimary">@color/appine_on_primary</item>
        <item name="colorPrimaryContainer">@color/appine_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/appine_on_primary_container</item>
        <item name="colorSecondary">@color/appine_secondary</item>
        <item name="colorOnSecondary">@color/appine_on_secondary</item>
        <item name="colorSecondaryContainer">@color/appine_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/appine_on_secondary_container</item>
        <item name="colorTertiary">@color/appine_tertiary</item>
        <item name="colorOnTertiary">@color/appine_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/appine_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/appine_on_tertiary_container</item>
        <item name="colorSurface">@color/appine_surface</item>
        <item name="colorOnSurface">@color/appine_on_surface</item>
        <item name="colorSurfaceVariant">@color/appine_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/appine_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/appine_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/appine_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/appine_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/appine_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/appine_surface_container_highest</item>
        <item name="colorOutline">@color/appine_outline</item>
        <item name="colorOutlineVariant">@color/appine_outline_variant</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- Also used by notification and privacy dialogs, independently of configuration night mode. -->
    <style name="Theme.Appine.Terminal" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/appine_dark_primary</item>
        <item name="colorOnPrimary">@color/appine_dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/appine_dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/appine_dark_on_primary_container</item>
        <item name="colorSecondary">@color/appine_dark_secondary</item>
        <item name="colorOnSecondary">@color/appine_dark_on_secondary</item>
        <item name="colorSecondaryContainer">@color/appine_dark_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/appine_dark_on_secondary_container</item>
        <item name="colorTertiary">@color/appine_dark_tertiary</item>
        <item name="colorOnTertiary">@color/appine_dark_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/appine_dark_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/appine_dark_on_tertiary_container</item>
        <item name="colorSurface">@color/appine_dark_surface</item>
        <item name="colorOnSurface">@color/appine_dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/appine_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/appine_dark_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/appine_dark_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/appine_dark_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/appine_dark_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/appine_dark_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/appine_dark_surface_container_highest</item>
        <item name="colorOutline">@color/appine_dark_outline</item>
        <item name="colorOutlineVariant">@color/appine_dark_outline_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Keep CJK and other fallback glyphs from changing line height in controls and tooltips. -->
        <item name="android:fallbackLineSpacing">false</item>
    </style>

    <!-- The menu row handles presses; its checkbox needs no separate ripple background. -->
    <style name="ThemeOverlay.Appine.CheckPopup" parent="">
        <item name="controlBackground">@android:color/transparent</item>
        <item name="android:checkboxStyle">@style/Widget.Appine.CheckPopup</item>
    </style>
    <style name="Widget.Appine.CheckPopup" parent="android:Widget.Material.CompoundButton.CheckBox">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- The tab bar's ⋮ menu, placed like a toolbar's overflow menu (actionOverflowMenuStyle): over
         the button (overlapAnchor), its top at the bar's and its end at the button's (Gravity.END
         in MainActivity.showMenu), which is the screen's; then moved down 4 dp and left 3.5 dp. A
         positive horizontal offset would change nothing, as the popup is kept on the screen. The
         app is left to right only (no supportsRtl), so the offset is absolute -->
    <style name="Widget.Appine.MorePopup" parent="@style/Widget.Material3.PopupMenu.Overflow">
        <item name="android:dropDownHorizontalOffset">-3.5dp</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

</resources>
